# Same Supabase project as the StoreCount merchant app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which shop "/" opens — for the installed app and for anyone typing the bare
# domain.
#
# This is the SLUG ONLY, not a URL. For a shop at http://localhost:3001/store
# the value is:  store
# (A full URL is tolerated and reduced to its first path segment, but the slug
# is what belongs here.)
#
# Leave blank when the deployment serves a single published shop: it is then
# found automatically. Set it explicitly once there is more than one, otherwise
# "/" falls back to a "nothing here" message.
DEFAULT_STORE_SLUG=
